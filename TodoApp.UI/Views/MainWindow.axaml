<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TodoApp.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TodoApp.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="TodoApp.UI">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    
    <!-- Enable Data binding so you reduce manual UI-update code (AddTask) /-->
    <Grid>
        <DockPanel>
          
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Spacing="10" Margin="10">
                <TextBox Text="{Binding NewTaskTitle}" Watermark="New Task..." Width="300"></TextBox>
                <TextBox Text="{Binding NewTaskDescription}" Watermark="Description (optional)"></TextBox>
                <ComboBox SelectedIndex="{Binding NewTaskPriority}" PlaceholderText="Priority" Width="120">
                    <ComboBoxItem>Low</ComboBoxItem>
                    <ComboBoxItem>Medium</ComboBoxItem>
                    <ComboBoxItem>High</ComboBoxItem>
                </ComboBox>
                <Button Content="Add" Command="{Binding AddTaskCommand}"></Button>
            </StackPanel>
            
            <!-- List-add row /-->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Spacing="10" Margin="10">
                <ComboBox ItemsSource="{Binding Lists}"
                          SelectedItem="{Binding SelectedList}"
                          PlaceholderText="No List">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"></TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Text="{Binding NewListName}" Watermark="New List..." Width="300"></TextBox>
                <Button Content="Add List" Command="{Binding AddListCommand}"></Button>
            </StackPanel>
            
            <!-- List listbox /-->
            <ListBox ItemsSource="{Binding Lists}" DockPanel.Dock="Top" MaxHeight="150">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding Name}" Width="200"></TextBox>
                               <Button Content="Save"
                                       Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).RenameListCommand}"
                                       CommandParameter="{Binding}">
                               </Button>
                               <Button Content="Delete"
                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).DeleteListCommand}"
                                    CommandParameter="{Binding}">
                               </Button>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox> 
            
            <Button Content="Toggle View" Command="{Binding ToggleViewCommand}" DockPanel.Dock="Top" Margin="10"></Button>
            
            <ListBox ItemsSource="{Binding Tasks}" IsVisible="{Binding IsListView}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding List.Name, TargetNullValue= Unsorted}" Foreground="Gray" Margin="10,0,0,0"></TextBlock>
                                <TextBlock Text="{Binding Title}"></TextBlock>
                                <CheckBox IsChecked="{Binding IsDone}" 
                                          Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ToggleDoneCommand}"
                                          CommandParameter="{Binding}"
                                ></CheckBox>
                                <Button Content="Delete"
                                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).DeleteTaskCommand}"
                                        CommandParameter="{Binding}"
                                ></Button>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap"></TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
            <!-- Board View - Sibling to the listbox above /-->
            <Grid IsVisible="{Binding IsBoardView}" ColumnDefinitions="*,*">
                <StackPanel>
                    <TextBlock Text="To Do" FontWeight="Bold" Margin="10"></TextBlock>
                    <ItemsControl ItemsSource="{Binding NotDoneTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Margin="10,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Done" FontWeight="Bold" Margin="10"></TextBlock>
                    <ItemsControl ItemsSource="{Binding DoneTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Margin="10,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
