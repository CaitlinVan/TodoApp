<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TodoApp.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TodoApp.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="TodoApp.UI">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    
    <!-- Enable Data binding so you reduce manual UI-update code (AddTask) /-->
    <Grid Margin="20">
        <DockPanel>

            <Border Classes="toolbar-card" DockPanel.Dock="Top">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Text="{Binding NewTaskTitle}" Watermark="New Task..." Width="300"></TextBox>
                        <TextBox Text="{Binding NewTaskDescription}" Watermark="Description (optional)"></TextBox>
                        <ComboBox SelectedIndex="{Binding NewTaskPriority}" PlaceholderText="Priority" Width="120">
                            <ComboBoxItem>Low</ComboBoxItem>
                            <ComboBoxItem>Medium</ComboBoxItem>
                            <ComboBoxItem>High</ComboBoxItem>
                        </ComboBox>
                        <Button Content="Add" Command="{Binding AddTaskCommand}" Classes="primary"></Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ComboBox ItemsSource="{Binding Lists}"
                                  SelectedItem="{Binding SelectedList}"
                                  PlaceholderText="No List">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"></TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Text="{Binding NewListName}" Watermark="New List..." Width="300"></TextBox>
                        <Button Content="Add List" Command="{Binding AddListCommand}" Classes="primary"></Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Lists}" DockPanel.Dock="Top" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="list-chip">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBox Text="{Binding Name}" Width="120" Background="Transparent" BorderThickness="0" Padding="0"></TextBox>
                                <Button Content="Save" Classes="ghost"
                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RenameListCommand}"
                                        CommandParameter="{Binding}">
                                </Button>
                                <Button Content="Delete" Classes="ghost"
                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DeleteListCommand}"
                                        CommandParameter="{Binding}">
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Toggle View" Command="{Binding ToggleViewCommand}" DockPanel.Dock="Top" Classes="secondary" Margin="0,0,0,16"></Button>
            
            <ListBox ItemsSource="{Binding Tasks}" IsVisible="{Binding IsListView}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="task-card">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" 
                                               Foreground="{StaticResource BrushTextPrimary}" 
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" 
                                              Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ToggleDoneCommand}"
                                              CommandParameter="{Binding}"/>
                                    <Button Content="Delete"
                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).DeleteTaskCommand}"
                                            CommandParameter="{Binding}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Border Classes="tag tag-todo" HorizontalAlignment="Left" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding List.Name, TargetNullValue=unsorted}" Classes="tag-todo-text"/>
                                </Border>
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource BrushTextSecondary}" 
                                           FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
            <!-- Board View - Sibling to the listbox above /-->
            <Grid IsVisible="{Binding IsBoardView}" ColumnDefinitions="*,*">
                <Border Classes="board-column-todo" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="To do" FontWeight="SemiBold" Foreground="{StaticResource BrushCoralDark}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding NotDoneTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="task-card">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <Border Classes="tag tag-todo" HorizontalAlignment="Left" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding List.Name, TargetNullValue=unsorted}" Classes="tag-todo-text"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Classes="board-column-done" Grid.Column="1" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Done" FontWeight="SemiBold" Foreground="{StaticResource BrushGreen}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding DoneTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="task-card">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" 
                                                       Foreground="{StaticResource BrushTextSecondary}" TextDecorations="Strikethrough"/>
                                            <Border Classes="tag tag-done" HorizontalAlignment="Left" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding List.Name, TargetNullValue=unsorted}" Classes="tag-done-text"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>