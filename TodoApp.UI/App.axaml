<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TodoApp.UI.App"
             xmlns:local="using:TodoApp.UI"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="ColorBackground">#FFFDF9</Color>
            <Color x:Key="ColorSurface">#FFFFFF</Color>
            <Color x:Key="ColorTodoBg">#FFF3E9</Color>
            <Color x:Key="ColorDoneBg">#EAF7EE</Color>
            <Color x:Key="ColorCoral">#FF8552</Color>
            <Color x:Key="ColorCoralDark">#D9722C</Color>
            <Color x:Key="ColorCoralTag">#FFE4D1</Color>
            <Color x:Key="ColorGreen">#3E9A5A</Color>
            <Color x:Key="ColorGreenTag">#D9F0DF</Color>
            <Color x:Key="ColorTextPrimary">#3A342A</Color>
            <Color x:Key="ColorTextSecondary">#8A8072</Color>

            <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}"/>
            <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}"/>
            <SolidColorBrush x:Key="BrushTodoBg" Color="{StaticResource ColorTodoBg}"/>
            <SolidColorBrush x:Key="BrushDoneBg" Color="{StaticResource ColorDoneBg}"/>
            <SolidColorBrush x:Key="BrushCoral" Color="{StaticResource ColorCoral}"/>
            <SolidColorBrush x:Key="BrushCoralDark" Color="{StaticResource ColorCoralDark}"/>
            <SolidColorBrush x:Key="BrushCoralTag" Color="{StaticResource ColorCoralTag}"/>
            <SolidColorBrush x:Key="BrushGreen" Color="{StaticResource ColorGreen}"/>
            <SolidColorBrush x:Key="BrushGreenTag" Color="{StaticResource ColorGreenTag}"/>
            <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
            <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>

            <Color x:Key="SystemAccentColor">#FF8552</Color>
            <Color x:Key="SystemAccentColorDark1">#D9722C</Color>
            <Color x:Key="SystemAccentColorLight1">#FFA478</Color>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource BrushBackground}"/>
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter"/>
        </Style>

        <Style Selector="Border.task-card">
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BoxShadow" Value="0 1 4 0 #0A000000"/>
        </Style>

        <Style Selector="Border.tag">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>

        <Style Selector="Border.tag-todo">
            <Setter Property="Background" Value="{StaticResource BrushCoralTag}"/>
        </Style>

        <Style Selector="Border.tag-done">
            <Setter Property="Background" Value="{StaticResource BrushGreenTag}"/>
        </Style>

        <Style Selector="TextBlock.tag-todo-text">
            <Setter Property="Foreground" Value="{StaticResource BrushCoralDark}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.tag-done-text">
            <Setter Property="Foreground" Value="{StaticResource BrushGreen}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Border.board-column-todo">
            <Setter Property="Background" Value="{StaticResource BrushTodoBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style Selector="Border.board-column-done">
            <Setter Property="Background" Value="{StaticResource BrushDoneBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource BrushCoral}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,6"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
        
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="Border.toolbar-card">
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BoxShadow" Value="0 1 4 0 #0A000000"/>
        </Style>

        <Style Selector="Border.list-chip">
            <Setter Property="Background" Value="{StaticResource BrushTodoBg}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="BorderBrush" Value="#F0E4D6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
        
    </Application.Styles>
</Application>